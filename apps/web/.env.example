# Copy to .env.local (never commit it). Server-side only: no NEXT_PUBLIC_ prefix,
# so these values are never sent to the browser.

# Where the Tindawise API (services/api) runs.
API_URL=http://localhost:8000

# TEMPORARY until authentication exists: the organization the app acts for.
# This is the sample store created by `python -m scripts.seed`.
TINDAWISE_ORG_ID=00000000-0000-4000-8000-000000000001
