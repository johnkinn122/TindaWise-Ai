{
  "name": "tindawise-ai",
  "private": true,
  "description": "Tindawise AI — intelligent retail platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "lint:web": "npm run lint --workspace web",
    "typecheck:web": "npm run typecheck --workspace web",
    "dev:api": "node scripts/api.mjs dev",
    "test:web": "npm run test --workspace web",
    "test:e2e": "npm run test:e2e --workspace web",
    "test:api": "node scripts/api.mjs test",
    "lint:api": "node scripts/api.mjs lint",
    "test:ml": "node scripts/ml.mjs test",
    "lint:ml": "node scripts/ml.mjs lint",
    "backtest:ml": "node scripts/ml.mjs backtest",
    "tune:ml": "node scripts/ml.mjs tune",
    "policies:ml": "node scripts/ml.mjs policies",
    "anomalies:ml": "node scripts/ml.mjs anomalies",
    "shrinkage:ml": "node scripts/ml.mjs shrinkage"
  },
  "engines": {
    "node": ">=22"
  }
}
