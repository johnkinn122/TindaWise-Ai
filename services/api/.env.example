# Copy to .env and adjust. Never commit .env.
# Matches infrastructure/docker-compose.yml (local development only).
DATABASE_URL=postgresql+psycopg://tindawise:tindawise_dev@localhost:5433/tindawise
TEST_DATABASE_URL=postgresql+psycopg://tindawise:tindawise_dev@localhost:5433/tindawise_test

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# development | test | production
ENVIRONMENT=development
